# Base : PGlite en local (dossier persistant, ou pglite:memory), PostgreSQL en production
# ex. prod : DATABASE_URL=postgres://matreso:matreso@db:5432/matreso
DATABASE_URL=pglite:./.data/pglite
# Secret de signature des cookies (≥ 16 caractères, OBLIGATOIRE en production)
SESSION_SECRET=change-me-change-me-change-me
# Port HTTP de l'API (3001 en dev, 3000 dans l'image Docker)
PORT=3001
NODE_ENV=development
# Origine publique du site, sans chemin ni « / » final (OBLIGATOIRE en production) : émetteur OAuth, ressource MCP (${PUBLIC_URL}/mcp) et page de consentement
PUBLIC_URL=http://localhost:3000
# Facteur appliqué aux limites par défaut des routes OAuth (/register 20 par heure, /token 50 par 15 min…), par IP ; 1 en production, relevé pour les tests e2e
OAUTH_RATE_LIMIT_MULTIPLIER=1
# Passkeys : domaine et origine exacts du site
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Ma Tréso
WEBAUTHN_ORIGIN=http://localhost:3000
# Cookies Secure (true derrière HTTPS)
COOKIE_SECURE=false
# Compte de démo demo@matreso.fr
SEED_DEMO=true
SEED_DEMO_PASSWORD=demo1234
# Dossier du build statique Nuxt servi par l'API (vide en dev)
WEB_DIST=
