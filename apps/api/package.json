{
  "name": "@matreso/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "dev:e2e": "tsc -p tsconfig.build.json && node --env-file=.env.e2e dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "seed": "node --env-file-if-exists=../../.env dist/seed/cli.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@matreso/engine": "^0.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/serve-static": "^12.0.0",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/server": "^14.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "typescript": "~5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
